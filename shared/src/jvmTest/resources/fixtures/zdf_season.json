{"data": {"smartCollectionByCanonical": {"__typename": "SeasonSeriesSmartCollection", "id": "cc718d26-7c86-4e13-a563-034ef8dce939", "title": "KRANK BERLIN", "canonical": "krank-berlin-100", "collectionType": "SEASON_SERIES", "editorialDate": "2026-11-13T06:31:18.258000+00:00", "teaser": {"title": "KRANK BERLIN", "description": "Unterbesetzt. Unterbezahlt. Überarbeitet: Die junge Ärztin Zanna übernimmt die Notaufnahme im Berliner \"KRANK\" und muss mit ihrem Team entgegen eines gnadenlosen Gesundheitsystems Leben retten.", "imageWithoutLogo": {"layouts": {"dim768X432": "https://www.zdf.de/assets/krank-berlin-hero-100~768x432?cb=1794405411133"}}}, "contentOwner": {"title": "ZDF"}, "seasons": {"totalCount": 1, "nodes": [{"title": "Staffel 1", "number": 1, "countEpisodes": 8, "episodes": {"nodes": [{"id": "ab7bda7e-5fec-441c-9a5b-3495ba936f2c", "title": "Symptome", "canonical": "symptome-104", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 1}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Symptome", "description": "Ben Weber, als Unfallchirurg in Berlin beschäftigt, hat nach einer Party-Nacht nur ein Ziel: in Ruhe ausnüchtern, bevor er seinen Dienst antritt.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/91d7bcbc-4c2d-431b-a0af-7c32cfb18d1b?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261125_2145_sendung_krb/4", "duration": 2528, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "01451dd7-8e10-468f-a3f3-b1a03f307a87", "title": "Ermittlungen", "canonical": "ermittlungen-106", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 2}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Ermittlungen", "description": "Zannas Chef hat einen unangenehmen Auftrag für sie: Sie soll das Personal beschnüffeln. Es gilt, den Verantwortlichen für den Tod eines Patienten zu finden.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/fd2aa371-7248-4813-b210-5dde19e9fd18?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261125_2225_sendung_krb/4", "duration": 2638, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "f021f0d2-56ab-4c66-8434-baa18ed2b30f", "title": "Diagnose", "canonical": "diagnose-112", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 3}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Diagnose", "description": "Zanna führt neue Regeln ein, damit die Rettungsstelle besser läuft. Die Belegschaft ist genervt, weil Zanna unter anderem die Medikamente und die Betäubungsmittel unter Verschluss nimmt.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/9936a820-1576-4a34-87e7-8bacdb09b839?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261202_2145_sendung_krb/4", "duration": 2704, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "e516853d-d4a7-4a56-8ea2-38ae8751c439", "title": "Behandlung", "canonical": "behandlung-100", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 4}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Behandlung", "description": "Zanna hat Geburtstag, will aber nicht feiern. Sie brütet über Tabellen und Zahlen. Wenn die Abteilung wirtschaftlicher werden soll, bleibt nur ein Weg.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/ed753ce9-5b46-4218-9d3d-8dc84bad97ad?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261202_2230_sendung_krb/3", "duration": 2665, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "3a979d69-eccc-4aeb-b2d9-79078bc3af20", "title": "Nebenwirkung", "canonical": "nebenwirkung-100", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 5}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Nebenwirkung", "description": "Dank der neuen Maßnahmen kann Zannas Station spielend die Flut an Seniorinnen und Senioren stemmen, die vom Sanitäterteam Olaf und Olivia in die Klinik gelenkt wird.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/1917567d-4834-4147-a6ee-ccf8a4a9261d?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261209_2145_sendung_krb/3", "duration": 2743, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "3326489d-52ee-46f8-98aa-b7adafb21729", "title": "Selbstmedikation", "canonical": "selbstmedikation-100", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 6}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Selbstmedikation", "description": "Ben ist wild entschlossen, seiner Drogenkarriere ein Ende zu setzen. Aber der einsetzende Turkey ist höllisch! Währenddessen unterläuft Assistenzarzt Dom ein weiterer schwerer Fehler.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/67956649-4337-44ab-8be7-d7805920842e?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261209_2230_sendung_krb/3", "duration": 2760, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "1d1e31bc-323b-400e-900e-2cedd3f97c28", "title": "Endstadium", "canonical": "endstadium-100", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 7}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Endstadium", "description": "Ben hat sich eine Überdosis gesetzt: Zanna und Kian finden ihn gerade noch rechtzeitig, um ihn ins Leben zurückzuholen. Zanna hadert: Ist ihr neues System wirklich okay?", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/645829f5-8c3b-4d3b-9b96-b75b6a705136?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261216_2145_sendung_krb/3", "duration": 2689, "vodMediaType": "DEFAULT", "geoLocation": "DACH"}]}}, {"id": "dd663aca-6dea-4c86-b308-31e5ca2c9e12", "title": "Remission", "canonical": "remission-100", "editorialDate": "2026-11-06T09:00:00.000000+00:00", "episodeInfo": {"seasonNumber": 1, "episodeNumber": 8}, "smartCollection": {"title": "KRANK BERLIN", "canonical": "krank-berlin-100"}, "teaser": {"title": "Remission", "description": "Der \"Venty-Club\", eine beliebte Feier-Location nahe der Klinik, brennt. Klar, dass die Notaufnahme nun vor einer großen Herausforderung steht.", "enableAudioDescription": false, "enableSubtitle": false, "imageWithoutLogo": {"layouts": {"dim768X432": "https://epg-image.zdf.de/fotobase-webdelivery/images/a068f7c8-e660-4315-9e92-3d2fedbbc159?layout=768x432"}}}, "currentMedia": {"nodes": [{"ptmdTemplate": "/tmd/2/{playerId}/vod/ptmd/mediathek/261216_2230_sendung_krb/4", "duration": 2592, "vodMediaType"